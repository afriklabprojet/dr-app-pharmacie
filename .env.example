# Configuration DR-PHARMA Pharmacie
# Copiez ce fichier vers .env.development ou .env.production et ajustez les valeurs

# URL de base de l'API
# - Émulateur Android: http://10.0.2.2:8000
# - Simulateur iOS: http://127.0.0.1:8000
# - Device physique: http://[IP_DE_VOTRE_MACHINE]:8000
# - Production: https://api.drpharma.ci
API_BASE_URL=http://10.0.2.2:8000

# Timeout des requêtes API en millisecondes
API_TIMEOUT=15000

# Environnement: development, staging, production
APP_ENV=development

# Activer le mode debug (logs détaillés)
DEBUG_MODE=true
