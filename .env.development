# Configuration développement
# Utilisé avec: flutter run --dart-define=ENV=development

# Pour Web (Chrome/Safari): 127.0.0.1
# Pour émulateur Android: 10.0.2.2
# Pour simulateur iOS: 127.0.0.1
# Pour device physique: IP de votre machine (ex: 192.168.1.x)
API_BASE_URL=http://127.0.0.1:8000
API_TIMEOUT=15000
APP_ENV=development
DEBUG_MODE=true
